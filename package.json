{
  "name": "@caslanqa/ai-gateway",
  "version": "0.1.0",
  "description": "A local OpenAI-compatible gateway with configurable model routing and an admin UI.",
  "license": "UNLICENSED",
  "type": "module",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "ai-gateway": "./dist/cli.js"
  },
  "files": [
    "dist",
    "config",
    "README.md",
    "SPEC.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src tests eslint.config.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "package": "npm run build && npm pack",
    "start": "node dist/cli.js start"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "better-sqlite3": "^13.0.3",
    "commander": "^14.0.0",
    "fastify": "^5.12.5",
    "openai": "^7.15.0",
    "yaml": "^2.8.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^22.18.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.1"
  }
}
